# --- Base de datos (PostgreSQL) ---
# Local: `docker compose up -d` levanta Postgres con estas credenciales.
DATABASE_URL="postgresql://salud:salud@localhost:5432/medicita?schema=public"

# --- Aplicación ---
# URL pública (se usa en redirecciones de Stripe). En Vercel: https://tu-dominio.com
APP_URL="http://localhost:3000"
# Secreto para firmar las sesiones (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+"

# --- IA (OpenAI) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
# Máximo de mensajes al asistente por usuario y día.
AI_DAILY_MESSAGE_LIMIT="60"

# --- Stripe (suscripciones de médicos/clínicas) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# IDs de precio recurrentes creados en el dashboard de Stripe.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_CLINIC=""
